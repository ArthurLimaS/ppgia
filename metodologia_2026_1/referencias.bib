	doi = {10.1109/ICCCIS60361.2023.10425722},
	abstract = {The stock market is an option for investment and trading. The market volatility and a wide range of other dependent and independent elements that affect the market value of a particular stock make it challenging to anticipate future values. These characteristics make it extremely difficult for any stock market expert to accurately forecast the market's growth and decline. Stock market predictors help determine future stock prices by taking the previous year's data into account. The prediction is done by the various machine learning models. This paper focuses on forecasting future stock values. using various best machine learning algorithms: k-Nearest Neighbors (KNN), Ada Boost, Support Vector Machine (SVM), Random Forest (RF), and XGBoost. The performance is analyzed using the MSE. Results show that the XGBOOST model is efficient in generating future stock prices and performs with a mean squared error of 0.004, mean absolute error of 0.014 and R2 score of 0.995.},
	urldate = {2026-04-05},
	booktitle = {2023 {International} {Conference} on {Computing}, {Communication}, and {Intelligent} {Systems} ({ICCCIS})},
	author = {Sharma, Priyanka and Jain, Mayank Kumar},
	month = nov,
	year = {2023},
	keywords = {Computational modeling, MSE (Mean Squared Error), Machine learning, Predictive models, Random forests, Stock Market Prediction, Stock markets, Strange Writing, Support vector machines, Time series analysis},
	pages = {317--322},
}

@inproceedings{kiruba_risk_2025,
	title = {Risk {Prediction} in {Financial} {Markets} {Using} {Hybrid} {AI} and {Time} {Series} {Forecasting} {Models}},
	doi = {10.1109/SENNET64220.2025.11135930},
	abstract = {The ability to properly anticipate potential risk is essential when making investment decisions since financial markets are typically hard to predict. This work presents a new method for risk prediction improvement that combines traditional time series forecasting models with artificial intelligence. The suggested model combines Long Short-Term Memory (LSTM) networks with Autoregressive Integrated Moving Average (ARIMA) to detect nonlinear relationships and statistical patterns in financial data. Feature selection methods are utilized to reduce the input data, hence the precision in making predictions. The hybrid model is trained and cross-validated on past market data, and its performance is tracked using assessment metrics that quantify key parameters, including Root Mean Squared Error (RMSE) and Mean Squared Error (MSE). The experimental findings show that our hybrid model produces more accurate risk predictions than the LSTM or ARIMA models alone. The results of this study, providing evidence of AI-based models' effectiveness in the management of financial risks, have considerable importance to investors, legislators, and analysts. As the suggested strategy enables proactive management of risks as well as judicious investment-making, it facilitates stability in markets. The hybrid model achieved a predicted accuracy of 92.7\%.},
	booktitle = {2025 {International} {Conference} on {Sensors} and {Related} {Networks} ({SENNET}) {Special} {Focus} on {Digital} {Healthcare}(64220)},
	author = {Kiruba, Angelin S. and Sri, D. Jyothi and Meenakshi, V. and Jeyaraman, S. and Gokul, R. and Kumaran, S.},
	month = jul,
	year = {2025},
	keywords = {Accuracy, Data models, Deep Learning, Deep learning, Financial Markets, Forecasting, Hybrid AI, Long short term memory, Machine Learning, Market research, Predictive models, Risk Prediction, Stability analysis, Strange Writing, Time Series Forecasting, Time series analysis, Training},
	pages = {1--7},
}

