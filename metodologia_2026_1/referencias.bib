
@article{hosseini_pattern-based_2025,
	title = {Pattern-{Based} {Feature} {Extraction} for {Improved} {Deep} {Learning} in {Financial} {Time} {Series} {Classification}},
	volume = {13},
	issn = {2169-3536},
	doi = {10.1109/ACCESS.2025.3584251},
	abstract = {In this paper, the authors introduce a novel feature extraction method based on pattern detection in financial data to enhance the performance of deep learning models for financial time series classification. Existing financial forecasting models often struggle with the inherent volatility and complexity of financial markets, particularly due to their reliance on traditional financial data features which fail to capture intricate price patterns. This research addresses the critical gap in effectively identifying and leveraging these patterns to improve predictive accuracy. By collecting tick-by-tick data from the European Carbon Emission Allowance market and resampling it to a 15-minute timeframe, we developed a method to detect pivotal price patterns and extract relevant features. Integrating these features with traditional open, high, low, close, and volume (OHLCV) data in long-short-term memory (LSTM) and gated recurrent unit (GRU) combined with dense neural networks, our empirical results demonstrate significant improvements in model performance, showcasing enhanced accuracy compared to models using only traditional data features.},
	journal = {IEEE Access},
	author = {Hosseini, Seyed Ali and Grimaccia, Francesco and Niccolai, Alessandro and Trimarchi, Silvia},
	year = {2025},
	keywords = {Accuracy, Biological system modeling, Data models, Deep learning, Energy market, Feature extraction, Forecasting, Long short term memory, Market research, Predictive models, Termômetro de Fatores Sociopolíticos e Comportamento Humano, Time series analysis, deep learning, financial data classification, financial feature extraction, financial pattern extraction},
	pages = {113343--113355},
}

@misc{hu_fintsb_2025,
	title = {{FinTSB}: {A} {Comprehensive} and {Practical} {Benchmark} for {Financial} {Time} {Series} {Forecasting}},
	shorttitle = {{FinTSB}},
	url = {http://arxiv.org/abs/2502.18834},
	doi = {10.48550/arXiv.2502.18834},
	abstract = {Financial time series (FinTS) record the behavior of human-brain-augmented decision-making, capturing valuable historical information that can be leveraged for profitable investment strategies. Not surprisingly, this area has attracted considerable attention from researchers, who have proposed a wide range of methods based on various backbones. However, the evaluation of the area often exhibits three systemic limitations: 1. Failure to account for the full spectrum of stock movement patterns observed in dynamic financial markets. (Diversity Gap), 2. The absence of unified assessment protocols undermines the validity of cross-study performance comparisons. (Standardization Deficit), and 3. Neglect of critical market structure factors, resulting in inflated performance metrics that lack practical applicability. (Real-World Mismatch). Addressing these limitations, we propose FinTSB, a comprehensive and practical benchmark for financial time series forecasting (FinTSF). To increase the variety, we categorize movement patterns into four specific parts, tokenize and pre-process the data, and assess the data quality based on some sequence characteristics. To eliminate biases due to different evaluation settings, we standardize the metrics across three dimensions and build a user-friendly, lightweight pipeline incorporating methods from various backbones. To accurately simulate real-world trading scenarios and facilitate practical implementation, we extensively model various regulatory constraints, including transaction fees, among others. Finally, we conduct extensive experiments on FinTSB, highlighting key insights to guide model selection under varying market conditions. Overall, FinTSB provides researchers with a novel and comprehensive platform for improving and evaluating FinTSF methods. The code is available at https://github.com/TongjiFinLab/FinTSBenchmark.},
	urldate = {2026-04-05},
	publisher = {arXiv},
	author = {Hu, Yifan and Li, Yuante and Liu, Peiyuan and Zhu, Yuxia and Li, Naiqi and Dai, Tao and Xia, Shu-tao and Cheng, Dawei and Jiang, Changjun},
	month = feb,
	year = {2025},
	note = {arXiv:2502.18834 [cs]},
	keywords = {Computer Science - Computational Engineering, Finance, and Science, Computer Science - Machine Learning, Termômetro de Fatores Sociopolíticos e Comportamento Humano},
}

@article{wang_stock_2023,
	title = {A {Stock} {Price} {Prediction} {Method} {Based} on {BiLSTM} and {Improved} {Transformer}},
	volume = {11},
	issn = {2169-3536},
	doi = {10.1109/ACCESS.2023.3296308},
	abstract = {How to maximize shareholder returns has always been a focus of research in the financial field. In order to improve the accuracy and stability of stock price prediction, this article proposes a new method, BiLSTM-MTRAN-TCN. Improve the transformer model and introduce TCN (Temporary Revolution Network) to construct a new transformer model (MTRAN-TCN), making it suitable for stock price prediction. This method consists of BiLSTM (Bi-directional Long Short-Term Memory) and MTRAN-TCN, which can fully utilize the advantages of the three models: BiLSTM, transformer and TCN. Transformer is good at obtaining full range distance information, but its ability to capture sequence information is weak. BiLSTM can capture bidirectional information in sequences, while TCN can capture sequence dependencies and improve the model’s generalization ability. Not only did the improvement effect of the transformer and the effectiveness of introducing the BiLSTM model be verified, but the effectiveness of the method was also verified using 5 index stocks and 14 Shanghai and Shenzhen stocks. Compared with other existing methods in the literature, this method has the best fit on each index stock, and the {\textbackslash}textR{\textasciicircum}2 of this method is the best in 85.7\% of the stock dataset. RMSE decreases by 24.3\% to 93.5\%, and {\textbackslash}textR{\textasciicircum}2 increases by 0.3\% to 15.6\%. In addition, this method has relatively stable prediction performance at different time periods and does not have timeliness issues. The results indicate that the BiLSTM-MTRAN-TCN method performs better in predicting stock prices, with high accuracy and generalization ability.},
	journal = {IEEE Access},
	author = {Wang, Shuzhen},
	year = {2023},
	keywords = {BiLSTM, Convolution, Convolutional neural networks, Data models, Deep learning, Hybrid junctions, Indexes, Maximizar Lucros e Retornos de Investimento, Predictive models, Stock markets, TCN, Time series analysis, Transformer, Transformers, deep learning, hybrid neural network, stock price prediction},
	pages = {104211--104223},
}

@inproceedings{liu_application_2024,
	title = {Application of an {ANN} and {LSTM}-{Based} {Ensemble} {Model} for {Stock} {Market} {Prediction}},
	url = {https://ieeexplore.ieee.org/document/10761432},
	doi = {10.1109/ICISCAE62304.2024.10761432},
	abstract = {Stock trading has always been a key economic indicator in modern society and a primary source of profit for financial giants such as investment banks, quantitative trading firms, and hedge funds. Discovering the underlying patterns within the seemingly volatile yet intrinsically structured economic activities has become a central focus of research for many companies. Our study leverages widely-used modern financial forecasting algorithms, including LSTM, ANN, CNN, and BiLSTM. We begin by comparing the predictive performance of these well-known algorithms on our stock market data, utilizing metrics such as R2, MAE, MSE, RMSE for detailed evaluation. Based on the performance of these models, we then aim to combine their strengths while mitigating their weaknesses, striving to construct a powerful hybrid model that overcomes the performance limitations of individual models. Through rigorous experimentation and exploration, we ultimately developed an LSTM+ANN model that breaks through prior performance bottlenecks, achieving promising and exciting results.},
	urldate = {2026-04-05},
	booktitle = {2024 {IEEE} 7th {International} {Conference} on {Information} {Systems} and {Computer} {Aided} {Education} ({ICISCAE})},
	author = {Liu, Fang and Guo, Shaobo and Xing, Qianwen and Sha, Xinye and Chen, Ying and Jin, Yuhui and Zheng, Qi and Yu, Chang},
	month = sep,
	year = {2024},
	note = {ISSN: 2770-663X},
	keywords = {AI, ANN, Biological system modeling, CNN, Computational modeling, Deep Learning, Ensemble, Finance, Investment, LSTM, Maximizar Lucros e Retornos de Investimento, Measurement, Prediction algorithms, Predictive models, Protection, Solid modeling, Stacking, Stock Prediction, Stock markets},
	pages = {390--395},
}

@article{sun_novel_2024,
	title = {A {Novel} {Integrated} {Approach} for {Stock} {Prediction} {Based} on {Modal} {Decomposition} {Technology} and {Machine} {Learning}},
	volume = {12},
	issn = {2169-3536},
	doi = {10.1109/ACCESS.2024.3425727},
	abstract = {After the COVID-19 ended, the global economy gradually recovered. Due to the nonlinearity, complexity, and high noise of financial time series, stock price prediction has become one of the most challenging tasks in the stock market. To tackle this challenge and enhance the prediction performance in the complicated stock markets, we propose a novel integrated approach based on Complete Ensemble Empirical Mode Decomposition with Adaptive Noise (CEEMDAN), Long Short-Term Memory (LSTM), and ensemble learning algorithm LightGBM to simultaneously improve the fitting and accuracy of stock price prediction. In addition, to prevent overfitting and improve predictive performance, this study adopted the Simulated Annealing (SA) algorithm for optimization. The predictive performance of the proposed hybrid model is comprehensively evaluated by comparing it with single LSTM, RNN, and other popular hybrid models. Three evaluation metrics, namely Root Mean Square Error (RMSE), Mean Absolute Error (MAE), and accuracy, are used to compare the aforementioned models. The experimental results indicate that the proposed hybrid CEEMDAN-LSTM-SA-LightGBM model outperforms all other comparative models in this study with better fitting and accuracy.},
	journal = {IEEE Access},
	author = {Sun, Yu and Mutalib, Sofianita and Omar, Nasiroh and Tian, Liwei},
	year = {2024},
	keywords = {CEEMDAN, Data models, Forecasting, Impacto Econômico e Políticas Públicas, LSTM, LightGBM, Long short term memory, Prediction algorithms, Predictive models, Pricing, Simulated annealing, Stock markets, Time series analysis, simulated annealing algorithm, stock price forecasting},
	pages = {95209--95222},
}

@inproceedings{ramkumar_development_2023,
	title = {Development of a {Robust} {Stock} {Market} {Prediction} {Mechanism} based on {Enhanced} {Comprehensive} {Learning} {Principles}},
	doi = {10.1109/RMKMATE59243.2023.10369559},
	abstract = {The use of deep learning to forecast stock market prices as well as trends has become increasingly common in the age of big data. Among the most complex challenges in machine learning is the prediction of share values, a task that is intricately tied to a multitude of influencing factors affecting supply and demand dynamics. This study introduces innovative hybrid methodologies for forecasting both stock market indices and stock prices. The initial approach involves the utilization of a Long Short-Term Memory (LSTM) Network. To enhance its predictive capabilities, the training process employs the backpropagation algorithm. Subsequently, the study incorporates an Autoregressive Integrated Moving Average (ARIMA) Model. This model not only unveils fundamental insights into prediction trends but also provides visual representations of projected outcomes. With an average prediction accuracy of 97.66\%, the ARIMA model yields satisfactory results. However, it's worth noting that achieving this high accuracy demands the utilization of substantial training data and a considerable number of training epochs. To amplify predictive performance, the entire dataset is systematically divided into 15 distinct segments. Each segment is individually fed into the LSTM model, resulting in the attainment of maximum accuracy for each respective segment. This segmentation strategy has a profound impact on both the model's training time and prediction accuracy, underscoring the critical role of input volume in model performance.},
	booktitle = {2023 {International} {Conference} on {Research} {Methodologies} in {Knowledge} {Management}, {Artificial} {Intelligence} and {Telecommunication} {Engineering} ({RMKMATE})},
	author = {Ramkumar, G. and Mohanavel, V. and S, Raghavi and TamilSelvi, M. and Vijayashanthi, R.S. and Amruthavalli, Pette},
	month = nov,
	year = {2023},
	keywords = {ARIMA Model, Hybrid LSTM-ARIMA Model, Impacto Econômico e Políticas Públicas, LSTM, Market research, Predictive models, Solid modeling, Supply and demand, Training, Training data, Visualization, stock market prediction},
	pages = {1--8},
}

@article{li_accurate_2024,
	title = {Accurate {Stock} {Price} {Forecasting} {Based} on {Deep} {Learning} and {Hierarchical} {Frequency} {Decomposition}},
	volume = {12},
	issn = {2169-3536},
	url = {https://ieeexplore.ieee.org/document/10488422},
	doi = {10.1109/ACCESS.2024.3384430},
	abstract = {The stock market is playing an increasingly important role in the global economy. Accurate stock price forecasting not only aids the government in predicting economic trends but also helps investors anticipate higher expected returns. Nevertheless, hurdles such as nonlinearity, complexity and high volatility make it a daunting task to predict stock prices. To address this issue, this study proposes a new hybrid model, termed Hierarchical Decomposition-based Forecasting Model (HDFM), to decompose and forecast stock prices in a hierarchical fashion. The model utilizes complete ensemble empirical mode decomposition with adaptive noise (CEEMDAN) for the initial decomposition of stock price time series. To enhance the predictive efficiency, sub-series with similar sample entropy from the decomposition were combined using the K-means clustering method. Through a thorough analysis, it was found that the first combined sub-series contained more high-frequency signals. Therefore, the first combined sub-series is subjected to a second decomposition with variational mode decomposition (VMD). Subsequently, the gated recurrent unit (GRU) model was used to individually predict each sub-series. The final results were obtained by merging the prediction outcomes. The proposed model was evaluated on three different stock markets. The experimental results show that the proposed model outperforms other forecasting methods across all stock indices. Moreover, ablation studies demonstrated the effectiveness of each component within the proposed model.},
	urldate = {2026-04-05},
	journal = {IEEE Access},
	author = {Li, Yi and Chen, Lei and Sun, Cuiping and Liu, Guoxu and Chen, Chunlei and Zhang, Yonghui},
	year = {2024},
	keywords = {Adaptation models, Autoregressive processes, Clustering algorithms, Deep learning, Forecasting, Hidden Markov models, Hierarchical systems, Impacto Econômico e Políticas Públicas, Predictive models, Stock markets, Stock price prediction, Time series analysis, clustering, deep learning, hierarchical decomposition},
	pages = {49878--49894},
}

